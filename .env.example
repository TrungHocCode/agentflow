# AgentFlow Environment Configuration

# App Config
ENVIRONMENT=local
# AUTH_MODE: "required" or "disabled"; defaults to disabled only for ENVIRONMENT=test.
AUTH_MODE=required
# REPOSITORY_BACKEND: "postgres" or "memory"; defaults to memory only for ENVIRONMENT=test.
REPOSITORY_BACKEND=postgres
LOG_LEVEL=INFO
AUTH_SIGNING_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL=3600
CORS_ORIGINS=http://localhost:5173
LLM_BASE_URL=http://localhost:11434
# Optional: set this to a host-reachable Ollama address when API/worker run in Docker.
OLLAMA_BASE_URL=

# Local model provider: "ollama" (default) or "llamacpp" (llama-server, OpenAI-compatible API).
# llama-server must run with --jinja for tool calling, e.g.:
#   llama-server -m <model.gguf> --port 8080 --jinja -c 8192
LLM_PROVIDER=ollama
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# Ignored by llama-server unless it was started with --api-key.
LLAMACPP_API_KEY=not-needed

# Optional web search keys (https://brave.com/search/api/, https://tavily.com). Brave is tried
# first, then Tavily. Without either, search uses DuckDuckGo's unauthenticated page, which can
# refuse requests from an IP for long periods.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
LLM_CHAT_MODEL=qwen3:0.6b
LLM_PLANNER_MODEL=qwen3:8b
LLM_WORKER_MODEL=qwen3:8b
# qwen3 hybrid models think by default; false makes them answer directly (much faster).
# LLM_THINKING=false
ARTIFACT_ROOT=workspace_data
MAX_RUN_DURATION=3600
MAX_RUN_LLM_CALLS=64
# Supervisor picks the next action at CI run decision points (default off)
CI_SUPERVISOR_DECISIONS=false
# Scout agent reads comparison pages to find competitors when none are named (default off)
CI_SCOUT_AGENT=true
# Estimated input plus reserved output across ReAct/map/reduce, not exact provider token usage.
MAX_RUN_ESTIMATED_TOKENS=262144
MAX_TASK_CONCURRENCY=1
# Context counts use an estimate before inference; provider usage is recorded separately.
LLM_CONTEXT_TOKENS=8192
LLM_OUTPUT_TOKENS=1024
LLM_CONTEXT_MARGIN_TOKENS=1024
RESEARCH_MAP_OUTPUT_TOKENS=768
RESEARCH_MAX_CHUNKS=32
RESEARCH_MAX_DOCUMENTS=8
RESEARCH_CHUNK_CHARS=3000
RESEARCH_MAX_REDUCE_CALLS=32
RESEARCH_MAX_REDUCE_DEPTH=4
# Enable only for local benchmarks. Data stays in backend metadata and is excluded from API/UI/SSE.
ENABLE_EXECUTION_BENCHMARK_METRICS=false

# PostgreSQL Configuration (Relational Data: Flow Definitions, Users, Catalogs)
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentflow_db
POSTGRES_URL=postgresql+asyncpg://agentflow:agentflow_password@localhost:5433/agentflow_db

# MongoDB Configuration (Document Data: Run History, Execution Logs, Heavy Artifacts)
MONGO_USER=agentflow
MONGO_PASSWORD=agentflow_password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=agentflow_runs
ENABLE_MONGODB=false
MONGO_URL=mongodb://agentflow:agentflow_password@localhost:27017/agentflow_runs?authSource=admin

# Redis Configuration (Transient Working Memory & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# LLM Provider API Keys (Optional defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
