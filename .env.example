# AgentFlow Environment Configuration

# App Config
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTH_SIGNING_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL=3600
CORS_ORIGINS=http://localhost:5173
LLM_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen3:8b
ARTIFACT_ROOT=workspace_data
MAX_RUN_DURATION=3600
MAX_TASK_CONCURRENCY=1
# Enable only for local benchmarks. Data stays in backend metadata and is excluded from API/UI/SSE.
ENABLE_EXECUTION_BENCHMARK_METRICS=false

# PostgreSQL Configuration (Relational Data: Flow Definitions, Users, Catalogs)
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentflow_db
POSTGRES_URL=postgresql+asyncpg://agentflow:agentflow_password@localhost:5433/agentflow_db

# MongoDB Configuration (Document Data: Run History, Execution Logs, Heavy Artifacts)
MONGO_USER=agentflow
MONGO_PASSWORD=agentflow_password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=agentflow_runs
ENABLE_MONGODB=false
MONGO_URL=mongodb://agentflow:agentflow_password@localhost:27017/agentflow_runs?authSource=admin

# Redis Configuration (Transient Working Memory & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# LLM Provider API Keys (Optional defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
